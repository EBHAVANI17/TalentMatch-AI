# =============================================================================
# Talent Match: environment configuration
# Copy to .env and adjust. Never commit a real .env file.
# All settings are read by backend/app/core/config.py.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | staging | production
# staging/production refuse to start with insecure defaults (see validate_for_runtime).
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Demo personas, 1-click logins and automatic demo seeding. MUST be false in production.
DEMO_MODE=true

# --- Database ----------------------------------------------------------------
# Default (unset): SQLite file at backend/data/talentmatch_production.db
# Docker / production: PostgreSQL 16 with the pgvector extension
# DATABASE_URL=postgresql+psycopg://talentmatch:talentmatch@localhost:5433/talentmatch
# Apply Alembic migrations automatically on startup
AUTO_MIGRATE=true

# Test suite only: run pytest against Postgres instead of a temp SQLite file
# TEST_DATABASE_URL=postgresql+psycopg://talentmatch:talentmatch@localhost:5433/talentmatch_test

# --- Authentication ----------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# --- HTTP --------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# --- Cache / queues (used from Phase 2) --------------------------------------
# REDIS_URL=redis://localhost:6379/0

# --- AI providers (used from Phase 4; free tiers work) -----------------------
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# --- AWS (production) --------------------------------------------------------
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=
# SES_FROM_EMAIL=

# --- Billing (Phase 10) ------------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
