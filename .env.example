# =============================================================================
# Talent Match: environment configuration
# Copy to .env and adjust. Never commit a real .env file.
# All settings are read by backend/app/core/config.py.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | staging | production
# staging/production refuse to start with insecure defaults (see validate_for_runtime).
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Demo personas, 1-click logins and automatic demo seeding. MUST be false in production.
DEMO_MODE=true

# --- Database ----------------------------------------------------------------
# Default (unset): SQLite file at backend/data/talentmatch_production.db
# Docker / production: PostgreSQL 16 with the pgvector extension
# DATABASE_URL=postgresql+psycopg://talentmatch:talentmatch@localhost:5433/talentmatch
# Apply Alembic migrations automatically on startup
AUTO_MIGRATE=true

# PostgreSQL roles for row-level security (alembic 0012 creates them; set their passwords yourself).
# DATABASE_URL must use talentmatch_app (no BYPASSRLS). Required as separate roles in production.
# DATABASE_URL=postgresql+psycopg://talentmatch_app:<password>@localhost:5433/talentmatch
# DATABASE_OWNER_URL=postgresql+psycopg://talentmatch:<password>@localhost:5433/talentmatch    # migrations
# DATABASE_ADMIN_URL=postgresql+psycopg://talentmatch_admin:<password>@localhost:5433/talentmatch
# DATABASE_WORKER_URL=postgresql+psycopg://talentmatch_worker:<password>@localhost:5433/talentmatch
# Emergency only: false = app-only tenant checks (requests run as the admin role). Logged as CRITICAL.
RLS_ENFORCED=true

# Test suite only: run pytest against Postgres instead of a temp SQLite file
# TEST_DATABASE_URL=postgresql+psycopg://talentmatch:talentmatch@localhost:5433/talentmatch_test

# --- Authentication ----------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Field-level encryption (candidate phone, resume text). Comma-separated Fernet keys, newest first.
# Required in staging/production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate: prepend a new key, restart, run `python -m app.db.rotate_encryption`, then drop old keys.
# DATA_ENCRYPTION_KEYS=

# --- HTTP --------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# --- Cache / queues (used from Phase 2) --------------------------------------
# REDIS_URL=redis://localhost:6379/0

# --- AI providers (free tiers work) ------------------------------------------
# Tried in this order; providers without a key are skipped. With no keys at all,
# AI features use deterministic rule-based fallbacks. Personal data is redacted first.
LLM_PROVIDER_ORDER=groq,gemini,openrouter
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TIMEOUT_SECONDS=25
LLM_COOLDOWN_SECONDS=60
# Per-user AI calls per day (protects free-tier quotas); 0 = unlimited
AI_USER_DAILY_LIMIT=100
# Copilot questions per client per minute (each question makes up to two AI calls)
RATE_LIMIT_COPILOT=20/minute

# --- AWS (production) --------------------------------------------------------
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=
# SES_FROM_EMAIL=

# --- Billing (Phase 10) ------------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- File storage ------------------------------------------------------------
# local (backend/storage/documents) | s3. S3 objects are private and encrypted; downloads use presigned URLs.
STORAGE_BACKEND=local
MAX_UPLOAD_MB=10
# S3_BUCKET_NAME=
# AWS_REGION=ap-south-1
# S3_ENDPOINT_URL=          # only for S3-compatible stores (MinIO, R2)

# --- Events & notifications -------------------------------------------------
# inline = deliver right after commit (single process); worker = run `python -m app.workers.outbox`
EVENT_DISPATCH_MODE=inline
NOTIFICATION_EMAIL_ENABLED=false

# --- Matching / embeddings --------------------------------------------------
# fastembed (local model, no API key) | hashing (offline, keyword-level only)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# EMBEDDING_CACHE_DIR=
